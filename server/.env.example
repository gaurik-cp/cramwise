# ─────────────────────────────────────────────────────────────
# Cramwise server settings.
# Copy this file to ".env" (same folder) and fill in the values.
# NEVER share your .env file or put it on GitHub: it holds secrets.
# ─────────────────────────────────────────────────────────────

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# This one is NOT secret (it's visible in the browser anyway).
GOOGLE_CLIENT_ID=

# From Google AI Studio (aistudio.google.com -> Get API key). THIS IS SECRET.
GEMINI_API_KEY=

# Which Gemini model to use. "gemini-flash-latest" always points to Google's
# newest Flash model. If Google renames things, put a model name here.
GEMINI_MODEL=gemini-flash-latest

# How many AI requests each person can make per day (protects your free quota).
AI_DAILY_LIMIT=40

# Lets you log in WITHOUT Google while testing on your own laptop.
# Only works from this computer (127.0.0.1). Set to 0 before putting the site online.
DEV_LOGIN=1

# Where the database lives. Leave empty to use a file (server/instance/cramwise.db).
# Online, you'd put a Postgres URL here, like postgresql://user:pass@host/db
DATABASE_URL=

# Set to 1 when the site runs on https (online). Keeps login cookies https-only.
COOKIE_SECURE=0

# Leave empty: the server makes a random secret on first run and saves it in instance/.
SECRET_KEY=
